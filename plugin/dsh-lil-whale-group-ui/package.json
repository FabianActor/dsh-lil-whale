{
  "name": "@fabianactor/dsh-lil-whale-group-ui",
  "version": "1.10.0",
  "type": "module",
  "description": "群聊页面：侧边栏一个图标，点开是三条鱼的群（读写 lil-whale\\group\\messages.jsonl）",
  "author": "Fabian",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabianActor/dsh-lil-whale.git",
    "directory": "plugin/dsh-lil-whale-group-ui"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "group-chat",
    "web-ui"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "icon.png",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "icon": "icon.png"
}
