{
  "name": "dsh-group-probe",
  "version": "0.0.1",
  "private": true,
  "description": "最小探针：只证明本地 bundle 能被 apply。不注册工具、不改界面、不碰任何东西，只在加载时往 probe.log 追加一行。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
