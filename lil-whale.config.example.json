  "chatCwd": "D:\\path\\to",
  "leeStartCwd": "C:\\Users\\you\\Desktop",
  "leeCwd": "D:\\path\\to\\dsh-lil-whale",
  "whaleCwd": "D:\\path\\to\\lil-whale",

